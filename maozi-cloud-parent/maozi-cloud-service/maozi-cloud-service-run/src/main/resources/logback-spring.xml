<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================================================
     Logback 日志配置（所有服务共享）
     ============================================================
     日志格式包含 trace_id / service / environment 等链路字段，
     便于 Promtail 采集后在 Loki/Grafana 中按服务和链路筛选。
     按运行环境区分输出方式：
       - local：异步控制台输出（ASYNC_CONSOLE）
       - 非 local：异步文件输出（ASYNC_FILE），按天+大小滚动
     ============================================================ -->
<configuration>

    <!-- 日志上下文名称 -->
    <contextName>logback</contextName>
    <!-- 关闭 Logback 内部状态输出 -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>
    <!-- Spring Boot 提供的颜色/异常格式转换器 -->
    <conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter" />
    <conversionRule conversionWord="wex" converterClass="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter" />
    <conversionRule conversionWord="wEx" converterClass="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter" />

    <!-- 从 Spring Environment 读取属性（yml 配置或环境变量），用于日志格式与输出方式判断 -->
    <springProperty scope="context" name="ENVIRONMENT" source="application.environment"/>
    <springProperty scope="context" name="APPLICATION_NAME" source="spring.application.name"/>
    <!-- 日志输出方式（logging.appender）：未配置时默认 ASYNC_CONSOLE，非 local 环境部署时应设为 ASYNC_FILE -->
    <springProperty scope="context" name="APPENDER" source="logging.appender" defaultValue="ASYNC_CONSOLE"/>

    <!-- 日志文件根目录 -->
    <springProperty scope="context" name="LOG_PATH" source="LOG_PATH" defaultValue="./logs"/>
    <!-- 日志文件完整路径（默认 ${LOG_PATH}/${APPLICATION_NAME}.log） -->
    <springProperty scope="context" name="LOG_FILE" source="LOG_FILE" defaultValue="${LOG_PATH}/${APPLICATION_NAME}.log"/>
    <!-- 日志输出格式：[ 时间 ] [ Level：级别 ] [ TID：链路追踪ID ] [ Service：服务名 ] [ Environment：环境 ] [ 消息 ] -->
    <property name="LOG_PATTERN" value="%clr([ %d{yyyy-MM-dd HH:mm:ss:SSS} ]){green}  %clr([ Level：%level ]){blue}  %clr([ TID：%X{trace_id:-} ]){magenta}  %clr([ Service：${APPLICATION_NAME} ]){red}  %clr([ Environment：${ENVIRONMENT} ]){yellow}  %clr([ %m ]){cyan}%n"/>

    <!-- ============ local 环境：控制台输出 ============ -->
    <if condition='property("ENVIRONMENT").contains("local")'>
        <then>
            <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
                <encoder>
                    <pattern>${LOG_PATTERN}</pattern>
                    <charset>UTF-8</charset>
                </encoder>
            </appender>

            <!-- 异步控制台输出，避免 IO 阻塞业务线程 -->
            <appender name ="ASYNC_CONSOLE" class= "ch.qos.logback.classic.AsyncAppender">
                <!-- 设为 0：不丢弃任何级别日志（默认队列剩余 20% 时丢 TRACE/DEBUG/INFO）-->
                <discardingThreshold>0</discardingThreshold>
                <!-- 异步日志队列大小-->
                <queueSize>512</queueSize>
                <!-- 不收集调用者信息（开启会明显降低性能）-->
                <includeCallerData>false</includeCallerData>
                <!-- false：队列满时阻塞业务线程（不丢日志）-->
                <neverBlock>false</neverBlock>
                <!-- 最终交给 CONSOLE 这个控制台输出器打印-->
                <appender-ref ref="CONSOLE"/>
            </appender>
        </then>
    </if>

    <!-- ============ 非 local 环境：文件输出（按天+大小滚动） ============ -->
    <if condition='!property("ENVIRONMENT").contains("local")'>
        <then>
            <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
                <!-- 当前写入的日志文件路径（LOG_FILE 未配置时默认 ${LOG_PATH}/${APPLICATION_NAME}.log）-->
                <file>${LOG_FILE}</file>
                <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                    <!-- 滚动归档文件名（按天 + 当日序号 %i） -->
                    <fileNamePattern>${LOG_PATH}/${APPLICATION_NAME}/%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                    <!-- 单文件超过 100MB 触发滚动 -->
                    <maxFileSize>100MB</maxFileSize>
                    <!-- 最多保留 30 天历史归档 -->
                    <MaxHistory>30</MaxHistory>
                </rollingPolicy>
                <encoder>
                    <pattern>${LOG_PATTERN}</pattern>
                    <charset>UTF-8</charset>
                </encoder>
            </appender>

            <!-- 异步文件输出，避免 IO 阻塞业务线程 -->
            <appender name="ASYNC_FILE" class= "ch.qos.logback.classic.AsyncAppender">
                <!-- 参数含义同 ASYNC_CONSOLE -->
                <discardingThreshold>0</discardingThreshold>
                <queueSize>512</queueSize>
                <includeCallerData>false</includeCallerData>
                <neverBlock>false</neverBlock>
                <appender-ref ref="FILE"/>
            </appender>
        </then>
    </if>

    <!-- 根日志记录器，根据 APPENDER 变量选择输出方式 -->
    <logger name="root" >
        <appender-ref ref="${APPENDER}"/>
    </logger>

</configuration>
