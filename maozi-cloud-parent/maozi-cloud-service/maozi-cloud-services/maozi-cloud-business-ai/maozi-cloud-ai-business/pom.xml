<?xml version="1.0" encoding="UTF-8"?>
<!-- AI 业务实现模块，基于 Spring AI Alibaba 接入通义千问，提供 AI 对话、对话记录等业务逻辑 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- 继承 AI 业务聚合工程，统一管理依赖版本 -->
    <parent>
        <groupId>com.maozi</groupId>
        <artifactId>maozi-cloud-business-ai</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- AI 业务实现模块构件名称 -->
    <artifactId>maozi-cloud-ai-business</artifactId>

    <properties>
        <!-- Spring AI 版本号 -->
        <spring-ai.version>1.0.0</spring-ai.version>
        <!-- Spring AI Alibaba 版本号 -->
        <spring-ai-alibaba.version>1.0.0.2</spring-ai-alibaba.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 引入 Spring AI BOM，统一管理 Spring AI 相关依赖版本 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 引入 Spring AI Alibaba BOM，统一管理 Alibaba 扩展依赖版本 -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-bom</artifactId>
                <version>${spring-ai-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- 阿里 DashScope（通义千问）模型 Starter，接入大模型对话能力 -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
            <!-- 排除非 jakarta 版 swagger-annotations（经 spring-ai-model 2.2.25 传入），其与 swagger-annotations-jakarta 存在同名类
                 io.swagger.v3.oas.annotations.media.Schema，旧类先加载会导致 springdoc 调用 Schema.$dynamicRef() 时抛 NoSuchMethodError -->
            <exclusions>
                <exclusion>
                    <groupId>io.swagger.core.v3</groupId>
                    <artifactId>swagger-annotations</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- 预留的其他模型 Starter（OpenAI / 智谱），需要时取消注释启用 -->
<!--        <dependency>-->
<!--            <groupId>org.springframework.ai</groupId>-->
<!--            <artifactId>spring-ai-starter-model-openai</artifactId>-->
<!--        </dependency>-->

<!--        <dependency>-->
<!--            <groupId>org.springframework.ai</groupId>-->
<!--            <artifactId>spring-ai-starter-model-zhipuai</artifactId>-->
<!--        </dependency>-->

        <!-- AOP 切面依赖，提供 AspectJ 注解与切面代理能力 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- 数据库实现插件，提供 MyBatis-Plus、数据源等数据库访问能力 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-service-db-impl</artifactId>
            <version>${maozi-cloud-service-db-impl.version}</version>
        </dependency>

        <!-- 服务 API 基类，提供通用的服务接口定义和异常封装 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-service-api</artifactId>
            <version>${maozi-cloud-service-api.version}</version>
        </dependency>

        <!-- Redis 配置模块，提供对话记忆等缓存存储 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-config-redis</artifactId>
            <version>${maozi-cloud-config-redis.version}</version>
        </dependency>

        <!-- AI 服务 API 模块，提供本业务对外接口与出入参定义 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-ai-api</artifactId>
            <version>${maozi-cloud-ai-api.version}</version>
        </dependency>

        <!-- 系统服务 API，调用系统管理服务的接口定义 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-system-api</artifactId>
            <version>${maozi-cloud-system-api.version}</version>
        </dependency>

        <!-- OAuth 服务 API，调用认证授权服务的接口定义 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-oauth-api</artifactId>
            <version>${maozi-cloud-oauth-api.version}</version>
        </dependency>

    </dependencies>

</project>