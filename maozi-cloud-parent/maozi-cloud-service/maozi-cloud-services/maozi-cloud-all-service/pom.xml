<?xml version="1.0" encoding="UTF-8"?>
<!-- 单体全量服务模块，将 oauth / system 等业务服务与单体部署插件聚合打包为单一可执行 JAR，作为单体部署形态的入口 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承业务服务聚合工程 maozi-cloud-services（其再向上继承 maozi-cloud-service → maozi-cloud-parent），统一管理依赖版本 -->
    <parent>
        <groupId>com.maozi</groupId>
        <artifactId>maozi-cloud-services</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- 单体全量服务构件名称 -->
    <artifactId>maozi-cloud-all-service</artifactId>

    <properties>

        <!-- 跳过单元测试 -->
        <maven.test.skip>true</maven.test.skip>
        <!-- 跳过 install 阶段 -->
        <maven.install.skip>true</maven.install.skip>
        <!-- 跳过 deploy 阶段 -->
        <maven.deploy.skip>true</maven.deploy.skip>

    </properties>


    <dependencies>

        <!-- System 业务服务实现，单体模式下作为本地 Bean 直接装配 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-system-business</artifactId>
            <version>${maozi-cloud-system-business.version}</version>
        </dependency>

        <!-- OAuth 业务服务实现，单体模式下作为本地 Bean 直接装配 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-oauth-business</artifactId>
            <version>${maozi-cloud-oauth-business.version}</version>
        </dependency>

        <!-- AI 业务服务实现，单体模式下作为本地 Bean 直接装配 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-ai-business</artifactId>
            <version>${maozi-cloud-ai-business.version}</version>
        </dependency>

        <!-- 单体部署插件，提供本地 Bean 装配能力，使 RPC 注解在单进程内退化为本地调用 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-service-monomer</artifactId>
            <version>${maozi-cloud-service-monomer.version}</version>
        </dependency>

        <!-- 数据库实现插件，提供 MyBatis-Plus、数据源等数据库访问能力 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-service-db-impl</artifactId>
            <version>${maozi-cloud-service-db-impl.version}</version>
        </dependency>

    </dependencies>

    <!-- boot打包 Begin -->
    <build>
        <!-- 打包后的文件名 -->
        <finalName>${artifactId}</finalName>
        <plugins>
            <!-- Spring Boot Maven 插件，将应用打包为可执行 JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- Spring Boot Maven 插件配置：指定启动主类、JVM 模块开放参数、依赖范围等打包细节 -->
                <configuration>
                    <!-- 指定应用启动主类 -->
                    <mainClass>com.maozi.Application</mainClass>
                    <!-- 包含 system scope 的依赖 -->
                    <includeSystemScope>true</includeSystemScope>
                    <!-- 排除 Lombok，运行时不需要 -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                    <!-- 添加 add-opens jvm参数 -->
                    <jvmArguments>
                        --add-opens java.base/java.math=ALL-UNNAMED
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        --add-opens java.base/java.lang.reflect=ALL-UNNAMED
                    </jvmArguments>
                </configuration>
                <executions>
                    <!-- 默认执行：调用 repackage goal 将依赖打入可执行 fat-jar -->
                    <execution>
                        <goals>
                            <!-- 重新打包为可执行 JAR -->
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <!-- boot打包 End -->

</project>