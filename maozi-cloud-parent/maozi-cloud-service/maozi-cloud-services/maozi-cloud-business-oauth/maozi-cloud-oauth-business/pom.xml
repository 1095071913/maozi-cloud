<?xml version="1.0" encoding="UTF-8"?>
<!-- OAuth 认证服务实现模块，基于 Spring Authorization Server 提供统一认证授权能力 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 OAuth 认证服务父工程，统一管理版本 -->
    <parent>
        <groupId>com.maozi</groupId>
        <artifactId>maozi-cloud-business-oauth</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- OAuth 认证服务实现模块构件名称 -->
    <artifactId>maozi-cloud-oauth-business</artifactId>

    <dependencies>

        <!-- Oauth Begin -->
        <!-- OAuth 认证服务 API，本模块对外暴露的接口契约 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-oauth-api</artifactId>
            <version>${maozi-cloud-oauth-api.version}</version>
        </dependency>
        <!-- Oauth End -->

        <!-- User Begin -->
        <!-- 系统管理服务 API，用于对接用户、角色等系统管理能力 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-system-api</artifactId>
            <version>${maozi-cloud-system-api.version}</version>
        </dependency>
        <!-- User End -->

        <!-- 服务 API 基类，提供通用的服务接口定义和异常封装 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-service-api</artifactId>
            <version>${maozi-cloud-service-api.version}</version>
        </dependency>

        <!-- Redis 配置模块，用于存储令牌等 OAuth2 授权信息 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-config-redis</artifactId>
            <version>${maozi-cloud-config-redis.version}</version>
        </dependency>

        <!-- 数据库实现插件，提供 MyBatis-Plus、数据源等数据库访问能力 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-service-db-impl</artifactId>
            <version>${maozi-cloud-service-db-impl.version}</version>
        </dependency>

        <!-- Spring Authorization Server 授权服务器核心依赖，提供 OAuth2 授权码、客户端凭证等认证流程 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-authorization-server</artifactId>
        </dependency>

    </dependencies>

</project>
