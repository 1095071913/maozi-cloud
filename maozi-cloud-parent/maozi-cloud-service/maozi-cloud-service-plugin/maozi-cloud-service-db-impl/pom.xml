  <modelVersion>4.0.0</modelVersion>

  <!-- 继承服务实现插件父工程，统一管理依赖版本 -->
  <parent>
    <groupId>com.maozi</groupId>
    <artifactId>maozi-cloud-service-plugin</artifactId>
    <version>${revision}</version>
  </parent>

  <!-- 服务数据库实现插件模块构件名称 -->
