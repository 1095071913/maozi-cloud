<?xml version="1.0" encoding="UTF-8"?>
<!-- 分布式部署插件模块，为「分布式」部署形态装配所需的 Dubbo / Feign / Sentinel / 服务发现等远程调用与治理能力 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承服务实现插件聚合父工程 -->
    <parent>
        <groupId>com.maozi</groupId>
        <artifactId>maozi-cloud-service-plugin</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- 分布式部署插件构件名称 -->
    <artifactId>maozi-cloud-service-distributed</artifactId>

    <dependencies>

        <!-- Dubbo 配置模块，集成 Apache Dubbo RPC 远程调用框架 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-config-dubbo</artifactId>
            <version>${maozi-cloud-config-dubbo.version}</version>
        </dependency>

        <!-- Feign 配置模块，集成 OpenFeign 声明式 HTTP 调用与拦截器 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-config-feign</artifactId>
            <version>${maozi-cloud-config-feign.version}</version>
        </dependency>

        <!-- 监控配置模块，集成 Spring Boot Admin 服务监控与指标暴露 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-config-monitor</artifactId>
            <version>${maozi-cloud-config-monitor.version}</version>
        </dependency>

        <!-- Sentinel 限流配置模块，集成熔断降级与流量控制规则 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-config-sentinel</artifactId>
            <version>${maozi-cloud-config-sentinel.version}</version>
        </dependency>

        <!-- 服务发现配置模块，集成注册中心服务注册与灰度负载均衡 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-config-nacos</artifactId>
            <version>${maozi-cloud-config-nacos.version}</version>
        </dependency>

    </dependencies>

</project>