<?xml version="1.0" encoding="UTF-8"?>
<!-- 服务监控模块，基于 Spring Boot Admin 实现微服务监控仪表盘 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- 继承业务服务聚合工程 maozi-cloud-services（其再向上继承 maozi-cloud-service → maozi-cloud-parent），统一管理依赖版本 -->
	<parent>
		<groupId>com.maozi</groupId>
		<artifactId>maozi-cloud-services</artifactId>
		<version>${revision}</version>
	</parent>

	<!-- 监控模块构件名称 -->
	<artifactId>maozi-cloud-basic-monitor</artifactId>

	<properties>

		<!-- 跳过单元测试 -->
		<maven.test.skip>true</maven.test.skip>
		<!-- 跳过 install 阶段 -->
		<maven.install.skip>true</maven.install.skip>
		<!-- 跳过 deploy 阶段 -->
		<maven.deploy.skip>true</maven.deploy.skip>

	</properties>

	<dependencies>

		<!-- ============ 项目内部依赖 Begin ============ -->

		<!-- 服务基础运行库，提供 BaseApplication、通用启动逻辑 -->
		<dependency>
			<groupId>com.maozi</groupId>
			<artifactId>maozi-cloud-service-run</artifactId>
			<version>${maozi-cloud-service-run.version}</version>
		</dependency>

		<!-- 监控配置模块，集成链路追踪、Spring Boot Admin 客户端注册与 Prometheus 指标暴露 -->
		<dependency>
			<groupId>com.maozi</groupId>
			<artifactId>maozi-cloud-config-monitor</artifactId>
			<version>${maozi-cloud-config-monitor.version}</version>
		</dependency>
		<!-- ============ 项目内部依赖 End ============ -->




		<!-- ============ SpringBoot 相关依赖 Begin ============ -->

		<!-- Spring Boot Web Starter，排除默认 Tomcat 服务器 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
			<exclusions>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-tomcat</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- Undertow Web 服务器，替代 Tomcat 作为高性能 Servlet 容器 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-undertow</artifactId>
		</dependency>
		<!-- Spring Boot End -->

		<!-- Spring Boot Admin Server 服务端，提供服务监控仪表盘 -->
		<dependency>
			<groupId>de.codecentric</groupId>
			<artifactId>spring-boot-admin-starter-server</artifactId>
			<version>${spring-boot-admin-starter.version}</version>
		</dependency>

		<!-- Micrometer Prometheus 指标导出，将应用指标暴露给 Prometheus 采集 -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>

		<!-- Spring Security 安全框架，提供监控仪表盘表单登录认证 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- ============ SpringBoot 相关依赖 End ============ -->




		<!-- ============ SpringCloud 相关依赖 Begin ============ -->

		<!-- Nacos 配置中心客户端，从 Nacos 拉取配置 -->
<!--		<dependency>-->
<!--			<groupId>com.alibaba.cloud</groupId>-->
<!--			<artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>-->
<!--		</dependency>-->

<!--		&lt;!&ndash; Nacos 服务发现客户端，将监控服务注册到 Nacos &ndash;&gt;-->
<!--		<dependency>-->
<!--			<groupId>com.alibaba.cloud</groupId>-->
<!--			<artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>-->
<!--		</dependency>-->
		<!-- 服务发现配置模块，集成 Nacos 注册中心客户端 -->
		<dependency>
			<groupId>com.maozi</groupId>
			<artifactId>maozi-cloud-config-nacos</artifactId>
			<version>${maozi-cloud-config-nacos.version}</version>
		</dependency>

		<!-- ============ SpringCloud 相关依赖 End ============ -->



		<!-- Netty macOS ARM64 DNS 解析器，解决 Apple Silicon 芯片下 DNS 解析问题 -->
		<dependency>
			<groupId>io.netty</groupId>
			<artifactId>netty-resolver-dns-native-macos</artifactId>
			<classifier>osx-aarch_64</classifier>
		</dependency>

	</dependencies>



	<!-- Spring Boot 打包配置 Begin -->
	<build>
		<!-- 打包后的文件名 -->
		<finalName>${artifactId}</finalName>
		<plugins>
			<!-- Spring Boot Maven 插件，将应用打包为可执行 JAR -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<!-- Spring Boot Maven 插件配置：指定启动主类、JVM 模块开放参数、依赖范围等打包细节 -->
				<configuration>
					<!-- 指定应用启动主类 -->
					<mainClass>com.maozi.Application</mainClass>
				</configuration>
				<executions>
					<!-- 默认执行：调用 repackage goal 将依赖打入可执行 fat-jar -->
					<execution>
						<goals>
							<!-- 重新打包为可执行 JAR -->
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<!-- Spring Boot 打包配置 End -->



</project>
