<?xml version="1.0" encoding="UTF-8"?>
<!-- 分布式锁配置模块，集成 Redisson 基于 Redis 实现分布式锁及 AOP 注解支持 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承配置聚合父工程，统一管理依赖版本 -->
    <parent>
        <groupId>com.maozi</groupId>
        <artifactId>maozi-cloud-config</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- 分布式锁配置模块构件名称 -->
    <artifactId>maozi-cloud-config-lock</artifactId>

    <dependencies>

        <!-- Redisson 分布式锁客户端，基于 Redis 提供可重入锁、公平锁等分布式锁实现 -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <version>${redisson.version}</version>
        </dependency>

        <!-- Spring AOP 切面支持，用于通过注解方式声明式使用分布式锁 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Project Begin -->
        <!-- 基础枚举定义模块，提供 Status、Deleted 等通用枚举 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-domain-enum</artifactId>
            <version>${maozi-cloud-domain-enum.version}</version>
        </dependency>

        <!-- Redis 缓存配置模块，提供 Redis 客户端配置与工具类支持 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-config-redis</artifactId>
            <version>${maozi-cloud-config-redis.version}</version>
        </dependency>
        <!-- Project End -->

    </dependencies>

</project>
