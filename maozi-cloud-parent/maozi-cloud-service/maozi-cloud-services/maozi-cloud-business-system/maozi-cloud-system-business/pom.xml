<?xml version="1.0" encoding="UTF-8"?>
<!-- 系统管理服务实现模块，负责用户、角色、菜单及图片存储等系统管理功能 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承系统管理服务父工程，统一管理版本 -->
    <parent>
        <groupId>com.maozi</groupId>
        <artifactId>maozi-cloud-business-system</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- 系统管理服务实现模块构件名称 -->
    <artifactId>maozi-cloud-system-business</artifactId>

    <dependencies>

        <!-- 阿里云 OSS V2 SDK，用于图片等文件的云存储 -->
        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>alibabacloud-oss-v2</artifactId>
            <version>0.5.1</version>
        </dependency>

        <!-- 数据库实现插件，提供 MyBatis-Plus、数据源等数据库访问能力 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-service-db-impl</artifactId>
            <version>${maozi-cloud-service-db-impl.version}</version>
        </dependency>

        <!-- 服务 API 基类，提供通用的服务接口定义和异常封装 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-service-api</artifactId>
            <version>${maozi-cloud-service-api.version}</version>
        </dependency>

        <!-- OAuth 认证服务 API，用于对接认证鉴权能力 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-oauth-api</artifactId>
            <version>${maozi-cloud-oauth-api.version}</version>
        </dependency>

        <!-- 系统管理服务 API，本模块对外暴露的接口契约 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-system-api</artifactId>
            <version>${maozi-cloud-system-api.version}</version>
        </dependency>

    </dependencies>

</project>
