<?xml version="1.0" encoding="UTF-8"?>
<!-- API 网关模块，基于 Spring Cloud Gateway 实现统一入口路由、灰度发布、限流熔断等功能 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- 继承业务服务聚合工程 maozi-cloud-services（其再向上继承 maozi-cloud-service → maozi-cloud-parent），统一管理依赖版本 -->
	<parent>
		<groupId>com.maozi</groupId>
		<artifactId>maozi-cloud-services</artifactId>
		<version>${revision}</version>
	</parent>

	<!-- 网关模块构件名称 -->
	<artifactId>maozi-cloud-gateway-service</artifactId>

	<properties>

		<!-- 跳过单元测试 -->
		<maven.test.skip>true</maven.test.skip>
		<!-- 跳过 install 阶段 -->
		<maven.install.skip>true</maven.install.skip>
		<!-- 跳过 deploy 阶段 -->
		<maven.deploy.skip>true</maven.deploy.skip>

	</properties>

	<dependencies>

		<!-- ============ 项目内部依赖 Begin ============ -->

		<!-- 通用工具类库，包含 JSON、对象操作等工具 -->
		<dependency>
			<groupId>com.maozi</groupId>
			<artifactId>maozi-cloud-utils</artifactId>
			<version>${maozi-cloud-utils.version}</version>
		</dependency>

		<!-- 服务基础运行库，提供 BaseApplication、通用启动逻辑 -->
		<dependency>
			<groupId>com.maozi</groupId>
			<artifactId>maozi-cloud-service-run</artifactId>
			<version>${maozi-cloud-service-run.version}</version>
		</dependency>

		<!-- 监控配置模块，集成 Spring Boot Admin 相关配置 -->
		<dependency>
			<groupId>com.maozi</groupId>
			<artifactId>maozi-cloud-config-monitor</artifactId>
			<version>${maozi-cloud-config-monitor.version}</version>
		</dependency>

		<!-- 服务发现配置模块，提供灰度负载均衡器等 -->
		<dependency>
			<groupId>com.maozi</groupId>
			<artifactId>maozi-cloud-config-nacos</artifactId>
			<version>${maozi-cloud-config-nacos.version}</version>
		</dependency>
		<!-- ============ 项目内部依赖 End ============ -->





		<!-- Spring Cloud Gateway 核心依赖，基于 WebFlux 的响应式网关 -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-gateway</artifactId>
		</dependency>

		<!-- Sentinel 网关适配，提供网关级别的限流熔断能力 -->
		<dependency>
			<groupId>com.alibaba.cloud</groupId>
			<artifactId>spring-cloud-alibaba-sentinel-gateway</artifactId>
		</dependency>

		<!-- Spring Cloud Alibaba Sentinel 核心依赖，提供限流熔断能力 -->
		<dependency>
			<groupId>com.alibaba.cloud</groupId>
			<artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
		</dependency>

		<!-- Sentinel 数据源 Nacos 扩展，将限流规则持久化到 Nacos 配置中心 -->
		<dependency>
			<groupId>com.alibaba.csp</groupId>
			<artifactId>sentinel-datasource-nacos</artifactId>
		</dependency>

		<!-- SpringDoc OpenAPI WebFlux 支持，用于聚合各服务的 Swagger 文档 -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webflux-api</artifactId>
			<version>${springdoc-openapi.version}</version>
		</dependency>

		<!-- Netty macOS ARM64 DNS 解析器，解决 Apple Silicon 芯片下 DNS 解析问题 -->
		<dependency>
			<groupId>io.netty</groupId>
			<artifactId>netty-resolver-dns-native-macos</artifactId>
			<version>4.1.84.Final</version>
			<classifier>osx-aarch_64</classifier>
		</dependency>

	</dependencies>


	<!-- Spring Boot 打包配置 Begin -->
	<build>
		<!-- 打包后的文件名 -->
		<finalName>${artifactId}</finalName>
		<plugins>
			<!-- Spring Boot Maven 插件，将应用打包为可执行 JAR -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<!-- Spring Boot Maven 插件配置：指定启动主类、JVM 模块开放参数、依赖范围等打包细节 -->
				<configuration>
					<!-- 指定应用启动主类 -->
					<mainClass>com.maozi.Application</mainClass>
					<!-- 包含 system scope 的依赖 -->
					<includeSystemScope>true</includeSystemScope>
					<!-- 排除 Lombok，运行时不需要 -->
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
					<!-- 添加 add-opens JVM 参数，解决 Java 17 模块化访问限制 -->
					<jvmArguments>
						--add-opens java.base/java.math=ALL-UNNAMED
						--add-opens java.base/java.lang=ALL-UNNAMED
						--add-opens java.base/java.lang.reflect=ALL-UNNAMED
					</jvmArguments>
				</configuration>
				<executions>
					<!-- 默认执行：调用 repackage goal 将依赖打入可执行 fat-jar -->
					<execution>
						<goals>
							<!-- 重新打包为可执行 JAR -->
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<!-- Spring Boot 打包配置 End -->

</project>
