<?xml version="1.0" encoding="UTF-8"?>
<!-- Sentinel 限流熔断配置模块，集成阿里巴巴 Sentinel 实现服务限流、熔断及降级 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- 继承配置聚合父工程，统一管理依赖版本 -->
	<parent>
		<groupId>com.maozi</groupId>
		<artifactId>maozi-cloud-config</artifactId>
		<version>${revision}</version>
	</parent>

	<!-- Sentinel 限流熔断配置模块构件名称 -->
	<artifactId>maozi-cloud-config-sentinel</artifactId>


	<dependencies>

		<!-- Spring 上下文，提供 ApplicationContextInitializer 启动初始化与组件注册支持 -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-context</artifactId>
		</dependency>

		<!-- Spring Cloud Alibaba Sentinel 核心依赖，提供限流熔断能力 -->
		<dependency>
			<groupId>com.alibaba.cloud</groupId>
			<artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
		</dependency>

		<!-- Sentinel Nacos 数据源，从 Nacos 配置中心读取限流熔断规则，实现规则持久化 -->
		<dependency>
			<groupId>com.alibaba.csp</groupId>
			<artifactId>sentinel-datasource-nacos</artifactId>
		</dependency>

		<!-- Sentinel Apache HttpClient 适配器，为 HttpClient 出站调用提供限流熔断支持 -->
		<dependency>
			<groupId>com.alibaba.csp</groupId>
			<artifactId>sentinel-apache-httpclient-adapter</artifactId>
			<version>${sentinel-adapter.version}</version>
		</dependency>

		<!-- Sentinel OkHttp 适配器，为 OkHttp 出站调用（如 Feign）提供限流熔断支持 -->
		<dependency>
			<groupId>com.alibaba.csp</groupId>
			<artifactId>sentinel-okhttp-adapter</artifactId>
			<version>${sentinel-adapter.version}</version>
		</dependency>

		<!-- Sentinel Apache Dubbo3 适配器，为 Dubbo RPC 调用提供限流熔断支持 -->
		<dependency>
			<groupId>com.alibaba.csp</groupId>
			<artifactId>sentinel-apache-dubbo3-adapter</artifactId>
			<version>${sentinel-adapter.version}</version>
		</dependency>

		<!-- 服务启动运行基础模块，提供 BaseApplication（注册 Sentinel 初始化日志过滤特征） -->
		<dependency>
			<groupId>com.maozi</groupId>
			<artifactId>maozi-cloud-service-run</artifactId>
			<version>${maozi-cloud-service-run.version}</version>
		</dependency>

		<!-- 项目通用工具类库 -->
		<dependency>
			<groupId>com.maozi</groupId>
			<artifactId>maozi-cloud-utils</artifactId>
			<version>${maozi-cloud-utils.version}</version>
		</dependency>

	</dependencies>


</project>
