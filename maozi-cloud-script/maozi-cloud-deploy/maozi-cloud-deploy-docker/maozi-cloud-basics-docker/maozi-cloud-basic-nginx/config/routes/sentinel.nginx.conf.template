# ============================================================
# Sentinel 控制台 (流量防护/流控规则管理, 自带登录 sentinel/sentinel)
# ------------------------------------------------------------
# 前缀 /sentinel/ 原样透传: 服务端已配 server.servlet.context-path=
# /sentinel (compose 环境变量 API_BASE_PATH, 见 application.properties),
# 前端 AuthInterceptor 按 index.htm 的 <base href="./"> 自动为全部
# $http 请求补 /sentinel 前缀 (fork 已内置该能力), 无需任何响应改写。
# Tomcat 对 context 根路径自动归一 /sentinel <-> /sentinel/, 无需尾斜杠跳转。
# 业务客户端 (sentinel transport) 不走本路由, 直连容器地址并已同步带
# /sentinel 后缀 (nacos: cloud-sentinel.yml)。
# 域名放入 $变量使解析延迟到请求期 (resolver 见 nginx.conf),
# sentinel 容器晚于本容器启动、重启换 IP 均可自动恢复。
# 登录由 Sentinel 自带登录页处理 (AUTH_USERNAME/PASSWORD), 不叠加
# nginx 层 form_auth, 避免双重登录。
# ============================================================

location /sentinel {
    set $mw_upstream maozi-cloud-basic-sentinel:8858;
    proxy_pass http://$mw_upstream;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
