<?xml version="1.0" encoding="UTF-8"?>
<!-- 猫子云统一父工程，作为整个微服务体系的根 POM，统一管理依赖版本、构建配置和公共组件 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<!-- 项目组织标识 -->
	<groupId>com.maozi</groupId>
	<!-- 统一父工程构件名称 -->
	<artifactId>maozi-cloud-parent</artifactId>
	<!-- 使用 ${revision} 占位符管理版本号，便于多模块统一升级 -->
	<version>${revision}</version>

	<!-- 打包类型为 pom，表示这是一个聚合工程 -->
	<packaging>pom</packaging>


	<properties>

		<!-- 项目统一版本号 -->
		<revision>2.0.0</revision>

		<!-- Java Begin -->
		<!-- Java 版本号 -->
		<java.version>17</java.version>
		<!-- Maven 编译源代码兼容版本 -->
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<!-- Maven 编译目标字节码版本 -->
		<maven.compiler.target>${java.version}</maven.compiler.target>

		<!-- 项目统一编码格式 -->
		<project.encoding>UTF-8</project.encoding>
		<!-- 构建源代码编码 -->
		<project.build.sourceEncoding>${project.encoding}</project.build.sourceEncoding>
		<!-- 报告输出编码 -->
		<project.reporting.outputEncoding>${project.encoding}</project.reporting.outputEncoding>
		<!-- Java End -->


		<!-- Spring Component Begin -->
		<!-- Spring Boot 版本 -->
		<spring-boot.version>3.3.5</spring-boot.version>
		<!-- Spring Cloud 版本 -->
		<spring-cloud.version>2023.0.3</spring-cloud.version>
		<!-- Spring Cloud Alibaba 版本 -->
		<spring-cloud-alibaba.version>2023.0.3.2</spring-cloud-alibaba.version>
		<!-- Spring Boot Admin 监控组件版本 -->
		<spring-boot-admin-starter.version>3.3.6</spring-boot-admin-starter.version>
		<!-- Spring Component End -->


		<!-- Other Component Begin -->
		<!-- CGLIB 动态代理版本 -->
		<cglib.version>3.3.0</cglib.version>
		<!-- Apache Dubbo RPC 通信框架版本 -->
		<dubbo.version>3.2.6</dubbo.version>
		<!-- Arthas Java 在线诊断工具版本 -->
		<arthas.version>4.0.5</arthas.version>
		<!-- Hutool Java 工具类库版本 -->
		<hutool.version>5.8.28</hutool.version>
		<!-- EasyPOI Excel 导入导出工具版本 -->
		<easypoi.version>4.3.0</easypoi.version>
		<!-- Swagger OpenAPI 注解版本 -->
		<swagger.version>2.2.47</swagger.version>
		<!-- MyBatis ORM 框架版本 -->
		<mybatis.version>3.5.10</mybatis.version>
		<!-- Redisson 分布式锁与缓存客户端版本 -->
		<redisson.version>3.18.0</redisson.version>
		<!-- XXL-JOB 分布式任务调度框架版本 -->
		<xxl-job-core.version>3.4.2</xxl-job-core.version>
		<!-- SnailJob 分布式任务调度与重试框架版本（2.x 需 JDK 21，当前项目 JDK 17 故使用 1.x 最新版） -->
		<snail-job.version>1.10.0</snail-job.version>
		<!-- MyBatis-Plus 增强版 ORM 框架版本 -->
		<mybatis-plus.version>3.5.6</mybatis-plus.version>
		<!-- TransmittableThreadLocal 阿里线程上下文传递工具版本 -->
		<transmittable.version>2.14.5</transmittable.version>
		<!-- Sentinel 适配器版本 -->
		<sentinel-adapter.version>1.8.8</sentinel-adapter.version>
		<!-- MyBatis-Plus-Join 多表连接查询插件版本 -->
		<mybatis-plus-join.version>1.5.7</mybatis-plus-join.version>
		<!-- SpringDoc OpenAPI 文档工具版本 -->
		<springdoc-openapi.version>2.8.17</springdoc-openapi.version>
		<!-- OpenTelemetry Instrumentation 可观测性组件版本（链路追踪、指标、日志 MDC） -->
		<opentelemetry-instrumentation.version>2.29.0</opentelemetry-instrumentation.version>
		<!-- Other Component End -->


		<!-- Project Begin -->

		<!-- 通用工具类库版本 -->
		<maozi-cloud-utils.version>${revision}</maozi-cloud-utils.version>

		<!-- 领域层 VO 视图对象模块版本 -->
		<maozi-cloud-domain-vo.version>${revision}</maozi-cloud-domain-vo.version>
		<!-- 领域层 DTO 数据传输对象模块版本 -->
		<maozi-cloud-domain-dto.version>${revision}</maozi-cloud-domain-dto.version>
		<!-- 领域层 Enum 枚举定义模块版本 -->
		<maozi-cloud-domain-enum.version>${revision}</maozi-cloud-domain-enum.version>

		<!-- 数据库配置模块版本 -->
		<maozi-cloud-config-db.version>${revision}</maozi-cloud-config-db.version>
		<!-- 日志配置模块版本 -->
		<maozi-cloud-config-log.version>${revision}</maozi-cloud-config-log.version>
		<!-- Web 层配置模块版本 -->
		<maozi-cloud-config-web.version>${revision}</maozi-cloud-config-web.version>
		<!-- 分布式锁配置模块版本 -->
		<maozi-cloud-config-lock.version>${revision}</maozi-cloud-config-lock.version>
		<!-- OAuth 安全认证配置模块版本 -->
		<maozi-cloud-config-oauth.version>${revision}</maozi-cloud-config-oauth.version>
		<!-- Redis 缓存配置模块版本 -->
		<maozi-cloud-config-redis.version>${revision}</maozi-cloud-config-redis.version>
		<!-- Dubbo RPC 配置模块版本 -->
		<maozi-cloud-config-dubbo.version>${revision}</maozi-cloud-config-dubbo.version>
		<!-- Feign 远程调用配置模块版本 -->
		<maozi-cloud-config-feign.version>${revision}</maozi-cloud-config-feign.version>
		<!-- Seata 分布式事务配置模块版本 -->
		<maozi-cloud-config-seata.version>${revision}</maozi-cloud-config-seata.version>
		<!-- 服务发现配置模块版本 -->
		<maozi-cloud-config-nacos.version>${revision}</maozi-cloud-config-nacos.version>
		<!-- Stream 消息流配置模块版本 -->
		<maozi-cloud-config-stream.version>${revision}</maozi-cloud-config-stream.version>
		<!-- 定时任务配置模块版本 -->
		<maozi-cloud-config-xxljob.version>${revision}</maozi-cloud-config-xxljob.version>
		<!-- SnailJob 任务调度与重试配置模块版本 -->
		<maozi-cloud-config-snailjob.version>${revision}</maozi-cloud-config-snailjob.version>
		<!-- Swagger API 文档配置模块版本 -->
		<maozi-cloud-config-openapi.version>${revision}</maozi-cloud-config-openapi.version>
		<!-- Spring Boot Admin 监控配置模块版本 -->
		<maozi-cloud-config-monitor.version>${revision}</maozi-cloud-config-monitor.version>
		<!-- Sentinel 限流熔断配置模块版本 -->
		<maozi-cloud-config-sentinel.version>${revision}</maozi-cloud-config-sentinel.version>

		<!-- 服务基础运行库版本 -->
		<maozi-cloud-service-run.version>${revision}</maozi-cloud-service-run.version>
		<!-- 服务 API 接口层版本 -->
		<maozi-cloud-service-api.version>${revision}</maozi-cloud-service-api.version>
		<!-- 服务实现层版本 -->
		<maozi-cloud-service-impl.version>${revision}</maozi-cloud-service-impl.version>
		<!-- 服务数据库实现层版本 -->
		<maozi-cloud-service-db-impl.version>${revision}</maozi-cloud-service-db-impl.version>
		<!-- 服务单体部署插件层版本 -->
		<maozi-cloud-service-monomer.version>${revision}</maozi-cloud-service-monomer.version>
		<!-- 服务分布式部署插件层版本 -->
		<maozi-cloud-service-distributed.version>${revision}</maozi-cloud-service-distributed.version>

		<!-- 系统管理服务 API 接口层版本 -->
		<maozi-cloud-system-api.version>${revision}</maozi-cloud-system-api.version>
		<!-- 系统管理服务实现层版本 -->
		<maozi-cloud-system-business.version>${revision}</maozi-cloud-system-business.version>

		<!-- OAuth 认证授权服务 API 接口层版本 -->
		<maozi-cloud-oauth-api.version>${revision}</maozi-cloud-oauth-api.version>
		<!-- OAuth 认证授权服务实现层版本 -->
		<maozi-cloud-oauth-business.version>${revision}</maozi-cloud-oauth-business.version>

		<maozi-cloud-ai-api.version>${revision}</maozi-cloud-ai-api.version>
		<maozi-cloud-ai-business.version>${revision}</maozi-cloud-ai-business.version>

		<!-- Project End -->


	</properties>


	<!-- Nexus 私服部署配置，发布构件到私服仓库 -->
	<distributionManagement>
		<!-- Release 版本发布仓库 -->
		<repository>
			<id>nexus-releases</id>
			<name>Nexus Release Repository</name>
			<url>http://localhost:8081/repository/maven-releases/</url>
		</repository>
		<!-- Snapshot 快照版本发布仓库 -->
		<snapshotRepository>
			<id>nexus-snapshots</id>
			<name>Nexus Snapshot Repository</name>
			<url>http://localhost:8081/repository/maven-snapshots/</url>
		</snapshotRepository>
	</distributionManagement>


	<!-- 依赖版本统一管理，通过 BOM 导入方式管理各组件版本 -->
	<dependencyManagement>
		<dependencies>

			<!-- Spring Boot 官方 BOM，统一管理 Spring Boot 全家桶依赖版本 -->
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring-boot.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Spring Cloud 官方 BOM，统一管理 Spring Cloud 生态依赖版本 -->
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Spring Cloud Alibaba 官方 BOM，统一管理 Alibaba 微服务组件依赖版本 -->
			<dependency>
				<groupId>com.alibaba.cloud</groupId>
				<artifactId>spring-cloud-alibaba-dependencies</artifactId>
				<version>${spring-cloud-alibaba.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

		</dependencies>
	</dependencyManagement>


	<!-- 全局公共依赖，所有子模块自动继承 -->
	<dependencies>

		<!-- JAVA EE Begin -->
		<!-- Jakarta Servlet API，提供 Web 容器 Servlet 规范支持 -->
		<dependency>
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
		</dependency>
		<!-- JAVA EE End -->


		<!-- Other Component Begin -->
		<!-- Lombok 代码生成工具，简化 POJO 模板代码 -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
		</dependency>
		<!-- Other Component End -->

	</dependencies>


	<!-- 构建配置 Begin -->
	<build>
		<plugins>
			<!-- Flatten 插件，生成扁平化 POM，解析 ${revision} 占位符，便于发布 -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
				<version>1.5.0</version>
				<!-- 插件配置：仅解析 ${revision} 等 CI Friendly 占位符，不删除其他 POM 元素 -->
				<configuration>
					<updatePomFile>true</updatePomFile>
					<flattenMode>resolveCiFriendliesOnly</flattenMode>
				</configuration>
				<executions>
					<!-- 在 process-resources 阶段生成扁平化 POM -->
					<execution>
						<id>flatten</id>
						<phase>process-resources</phase>
						<goals>
							<goal>flatten</goal>
						</goals>
					</execution>
					<!-- 在 clean 阶段清理已生成的扁平化 POM -->
					<execution>
						<id>flatten.clean</id>
						<phase>clean</phase>
						<goals>
							<goal>clean</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- Maven 编译插件，指定 Java 版本和编码 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<!-- 编译器配置：指定 Java 版本、编码、编译参数与告警输出 -->
				<configuration>
					<source>${java.version}</source>
					<target>${java.version}</target>
					<encoding>${project.encoding}</encoding>
					<parameters>true</parameters>
					<showWarnings>true</showWarnings>
				</configuration>
			</plugin>
			<!-- JAR 打包插件，在 MANIFEST 中写入构建信息 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<!-- 默认配置：不在 JAR 中写入 maven descriptor，避免泄露构建环境信息 -->
				<configuration>
					<archive>
						<addMavenDescriptor>false</addMavenDescriptor>
					</archive>
				</configuration>
				<executions>
					<!-- 默认执行：在 MANIFEST 中写入实现/规格信息与 Classpath -->
					<execution>
						<configuration>
							<archive>
								<manifest>
									<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
									<addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
									<addClasspath>true</addClasspath>
								</manifest>
							</archive>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- 资源处理插件，处理配置文件中的占位符替换 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
			</plugin>
			<!-- Install 插件，将构件安装到本地仓库 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-install-plugin</artifactId>
			</plugin>
			<!-- Clean 插件，清理构建产物 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
			</plugin>
			<!-- Antrun 插件，在构建过程中执行 Ant 任务 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
			</plugin>
			<!-- Dependency 插件，用于依赖分析和拷贝 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
			</plugin>
			<!-- Git Commit ID 插件，在构建时生成 git.properties 文件，记录 Git 提交信息 -->
			<plugin>
				<groupId>pl.project13.maven</groupId>
				<artifactId>git-commit-id-plugin</artifactId>
				<version>4.0.0</version>
				<executions>
					<!-- 在 initialize 阶段生成 git 元信息，供后续打包使用 -->
					<execution>
						<id>get-the-git-infos</id>
						<goals>
							<goal>revision</goal>
						</goals>
						<phase>initialize</phase>
					</execution>
				</executions>
				<!-- 输出 git.properties 文件，仅保留指定的 git 元数据字段 -->
				<configuration>
					<generateGitPropertiesFile>true</generateGitPropertiesFile>
					<generateGitPropertiesFilename>
						${project.build.outputDirectory}/git.properties</generateGitPropertiesFilename>
					<includeOnlyProperties>
						<includeOnlyProperty>^git.tags$</includeOnlyProperty>
						<includeOnlyProperty>^git.branch$</includeOnlyProperty>
						<includeOnlyProperty>^git.remote.origin.url$</includeOnlyProperty>
						<includeOnlyProperty>^git.build.(time|version)$</includeOnlyProperty>
						<includeOnlyProperty>^git.commit.id.(abbrev|full)$</includeOnlyProperty>
						<includeOnlyProperty>^git.commit.message.full$</includeOnlyProperty>
						<includeOnlyProperty>^git.commit.user.(name|email)$</includeOnlyProperty>
						<includeOnlyProperty>^git.build.user.(name|email)$</includeOnlyProperty>
					</includeOnlyProperties>
					<commitIdGenerationMode>full</commitIdGenerationMode>
				</configuration>
			</plugin>
		</plugins>
		<!-- 资源文件配置 -->
		<resources>
			<!-- 将 Java 目录下的非 .java 文件作为资源打包 -->
			<resource>
				<directory>src/main/java</directory>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
			</resource>
			<!-- 将 webapp 目录映射到 META-INF/resources 路径 -->
			<resource>
				<directory>src/main/webapp</directory>
				<targetPath>META-INF/resources</targetPath>
				<includes>
					<include>**/**</include>
				</includes>
			</resource>
			<!-- 将 resources 目录下的配置文件打包，并启用占位符过滤 -->
			<resource>
				<directory>src/main/resources</directory>
				<includes>
					<include>**/*.properties</include>
					<include>**/*.*</include>
				</includes>
				<filtering>true</filtering>
			</resource>
		</resources>
	</build>
	<!-- 构建配置 End -->

	<!-- 远程仓库配置 Begin -->
	<repositories>
		<!-- 阿里云 Maven 中央仓库镜像，加速国内依赖下载 -->
		<repository>
			<id>aliyun-repos</id>
			<name>Aliyun Repository</name>
			<url>http://maven.aliyun.com/nexus/content/groups/public</url>
			<releases>
				<enabled>true</enabled>
			</releases>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>
		<!-- Sonatype 公共仓库，提供开源组件 Release 版本 -->
		<repository>
			<id>sonatype-repos</id>
			<name>Sonatype Repository</name>
			<url>https://oss.sonatype.org/content/groups/public</url>
			<releases>
				<enabled>true</enabled>
			</releases>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>
		<!-- Sonatype 快照仓库，提供开源组件 Snapshot 版本 -->
		<repository>
			<id>sonatype-repos-s</id>
			<name>Sonatype Repository</name>
			<url>https://oss.sonatype.org/content/repositories/snapshots</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
		<!-- Spring 官方快照仓库，提供 Spring 生态 Snapshot 版本 -->
		<repository>
			<id>spring-snapshots</id>
			<name>Spring Snapshots</name>
			<url>https://repo.spring.io/snapshot</url>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
		<!-- Spring 官方里程碑仓库，提供 Spring 生态里程碑版本 -->
		<repository>
			<id>spring-milestones</id>
			<name>Spring Milestones</name>
			<url>https://repo.spring.io/milestone</url>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>
		<!-- JFrog JCenter 快照仓库 -->
		<repository>
			<id>jcenter-snapshots</id>
			<name>jcenter</name>
			<url>http://oss.jfrog.org/artifactory/oss-snapshot-local/</url>
		</repository>
	</repositories>
	<!-- 远程仓库配置 End -->

	<!-- 插件远程仓库配置 -->
	<pluginRepositories>
		<!-- 阿里云 Maven 插件镜像仓库 -->
		<pluginRepository>
			<id>aliyun-repos</id>
			<name>Aliyun Repository</name>
			<url>http://maven.aliyun.com/nexus/content/groups/public</url>
			<releases>
				<enabled>true</enabled>
			</releases>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</pluginRepository>
	</pluginRepositories>


	<!-- 子模块列表 -->
	<modules>
		<!-- 通用工具类库模块 -->
		<module>maozi-cloud-utils</module>
		<!-- 配置模块聚合工程 -->
		<module>maozi-cloud-config</module>
		<!-- 领域层聚合工程 -->
		<module>maozi-cloud-domain</module>
		<!-- 服务层聚合工程 -->
		<module>maozi-cloud-service</module>
	</modules>


</project>
