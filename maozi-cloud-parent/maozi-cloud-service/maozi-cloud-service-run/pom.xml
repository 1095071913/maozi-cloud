<?xml version="1.0" encoding="UTF-8"?>
<!-- 服务启动运行基础模块，提供 BaseApplication 基类与运行时配置初始化器加载等启动核心能力 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- 继承服务层父工程，统一管理依赖版本 -->
    <parent>
        <groupId>com.maozi</groupId>
        <artifactId>maozi-cloud-service</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- 服务启动运行基础模块构件名称 -->
    <artifactId>maozi-cloud-service-run</artifactId>


    <dependencies>

        <!-- 通用工具类依赖，启动时提供基础工具方法支持 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-utils</artifactId>
            <version>${maozi-cloud-utils.version}</version>
        </dependency>

        <!-- CRAC 预热加速，支持 Coordinated Restore at Checkpoint 快速启动 -->
        <dependency>
            <groupId>org.crac</groupId>
            <artifactId>crac</artifactId>
        </dependency>

        <!-- Janino 运行时编译器，用于 Logback 日志条件判断 -->
        <dependency>
            <groupId>org.codehaus.janino</groupId>
            <artifactId>janino</artifactId>
        </dependency>

    </dependencies>


</project>
