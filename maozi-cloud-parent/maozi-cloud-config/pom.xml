<?xml version="1.0" encoding="UTF-8"?>
<!-- 配置聚合工程，聚合管理各中间件及框架的通用配置子模块 -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承父工程，统一管理依赖版本 -->
    <parent>
        <groupId>com.maozi</groupId>
        <artifactId>maozi-cloud-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- 配置聚合工程构件名称 -->
    <artifactId>maozi-cloud-config</artifactId>
    <!-- 打包类型为 pom，表示这是一个聚合工程 -->
    <packaging>pom</packaging>

    <!-- 子模块列表 -->
    <modules>
      <!-- Feign 远程调用配置模块 -->
      <module>maozi-cloud-config-feign</module>
      <!-- 监控配置模块（链路追踪、Spring Boot Admin、Prometheus 指标） -->
      <module>maozi-cloud-config-monitor</module>
      <!-- Sentinel 限流熔断配置模块 -->
      <module>maozi-cloud-config-sentinel</module>
      <!-- 数据库（MyBatis-Plus）配置模块 -->
      <module>maozi-cloud-config-db</module>
      <!-- 日志记录配置模块 -->
      <module>maozi-cloud-config-log</module>
      <!-- OAuth 安全认证配置模块 -->
      <module>maozi-cloud-config-oauth</module>
      <!-- Web 层通用配置模块 -->
      <module>maozi-cloud-config-web</module>
      <!-- Seata 分布式事务配置模块 -->
      <module>maozi-cloud-config-seata</module>
      <!-- XXL-JOB 定时任务配置模块 -->
      <module>maozi-cloud-config-xxljob</module>
      <!-- Dubbo RPC 通信配置模块 -->
      <module>maozi-cloud-config-dubbo</module>
      <!-- Redis 缓存配置模块 -->
      <module>maozi-cloud-config-redis</module>
      <!-- Nacos 注册发现与配置中心配置模块 -->
      <module>maozi-cloud-config-nacos</module>
      <!-- Stream 消息流配置模块 -->
      <module>maozi-cloud-config-stream</module>
      <!-- Swagger API 文档配置模块 -->
      <module>maozi-cloud-config-openapi</module>
      <!-- 分布式锁配置模块 -->
      <module>maozi-cloud-config-lock</module>
      <!-- SnailJob 任务调度与重试配置模块 -->
      <module>maozi-cloud-config-snailjob</module>
    </modules>

</project>
