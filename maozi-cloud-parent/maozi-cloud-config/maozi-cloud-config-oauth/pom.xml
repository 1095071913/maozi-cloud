<?xml version="1.0" encoding="UTF-8"?>
<!-- OAuth2 认证配置模块，集成 Spring Security OAuth2 资源服务器实现统一身份认证 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- 继承配置聚合父工程，统一管理依赖版本 -->
	<parent>
		<groupId>com.maozi</groupId>
		<artifactId>maozi-cloud-config</artifactId>
		<version>${revision}</version>
	</parent>

	<!-- OAuth2 认证配置模块构件名称 -->
	<artifactId>maozi-cloud-config-oauth</artifactId>


	<dependencies>

		<!-- Project Begin -->

		<!-- 服务 API 接口定义，提供 OauthTokenService 令牌内省接口与 Token 声明常量 -->
		<dependency>
			<groupId>com.maozi</groupId>
			<artifactId>maozi-cloud-service-api</artifactId>
			<version>${maozi-cloud-service-api.version}</version>
		</dependency>
		<!-- Project End -->

		<!-- Spring Begin -->
		<!-- Spring WebMVC，提供 WebMvcConfigurer 与 HandlerInterceptor 拦截器注册支持 -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-webmvc</artifactId>
		</dependency>

		<!-- Spring Boot OAuth2 资源服务器，负责校验 Token 并提供身份认证 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>
		<!-- Spring End -->

	</dependencies>

</project>
