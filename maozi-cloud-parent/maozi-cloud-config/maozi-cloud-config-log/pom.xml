<?xml version="1.0" encoding="UTF-8"?>
<!-- 日志记录配置模块，提供请求入口日志切面抽象基类，统一记录请求、响应与异常日志 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- 继承配置聚合父工程，统一管理依赖版本 -->
	<parent>
		<groupId>com.maozi</groupId>
		<artifactId>maozi-cloud-config</artifactId>
		<version>${revision}</version>
	</parent>

	<!-- 日志记录配置模块构件名称 -->
	<artifactId>maozi-cloud-config-log</artifactId>


	<dependencies>


		<!-- Project Begin -->
		<!-- Spring AOP 切面支持，用于通过注解方式实现日志切面 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aop</artifactId>
		</dependency>

		<!-- 通用工具类库，提供日志记录所需的 JSON、字符串等基础工具方法 -->
		<dependency>
			<groupId>com.maozi</groupId>
			<artifactId>maozi-cloud-utils</artifactId>
			<version>${maozi-cloud-utils.version}</version>
		</dependency>
		<!-- Project End -->


	</dependencies>


</project>
